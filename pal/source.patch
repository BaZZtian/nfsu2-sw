+/* Mesa's Switch EGL driver calls fatalThrow directly on a native window
+ * failure. Those calls bypass the CPU exception hook. Preserve their exact
+ * result and fatal behavior, but persist the operation before the fatal. */
+#ifdef __SWITCH__
+#include <switch.h>
+#include <stdio.h>
+#include <string.h>
+#include "switch_graphics_debug.h"
+
+static _Thread_local const char *s_stage;
+static _Thread_local unsigned s_dequeue_seen, s_queue_seen;
+
+void nv2a_gl_debug_stage(const char *stage)
+{
+    if (!stage)
+        stage = "unspecified";
+    if (s_stage && strcmp(s_stage, stage) == 0)
+        return;
+    s_stage = stage;
+    fprintf(stderr, "[EU-P2-D1][graphics] stage=%s\n", stage);
+}
+
+static void report_window(const char *op, Result rc, s32 slot,
+                          NWindow *nw, const void *caller)
+{
+    fprintf(stderr, "[EU-P2-D1][graphics] op=%s rc=0x%X module=%u description=%u"
+            " stage=%s slot=%d caller=%p ELF_CALLER=0x%08X\n",
+            op, rc, R_MODULE(rc), R_DESCRIPTION(rc),
+            s_stage ? s_stage : "before-graphics-stage", slot, caller,
+            nfsu2_nx_graphics_offset(caller));
+    if (!nwindowIsValid(nw)) {
+        fprintf(stderr, "[EU-P2-D1][graphics] window=%p invalid\n", (void *)nw);
+        return;
+    }
+    fprintf(stderr, "[EU-P2-D1][graphics] window=%p connected=%u size=%ux%u"
+            " default=%ux%u format=0x%X usage=0x%X cur_slot=%d"
+            " configured=0x%016llX requested=0x%016llX"
+            " crop=%d,%d,%d,%d swap_interval=%u\n",
+            (void *)nw, (unsigned)nw->is_connected, nw->width, nw->height,
+            nw->default_width, nw->default_height, nw->format, nw->usage,
+            nw->cur_slot, (unsigned long long)nw->slots_configured,
+            (unsigned long long)nw->slots_requested, nw->crop.left,
+            nw->crop.top, nw->crop.right, nw->crop.bottom, nw->swap_interval);
+}
+
+Result __real_nwindowConfigureBuffer(NWindow *, s32, NvGraphicBuffer *);
+__attribute__((noinline))
+Result __wrap_nwindowConfigureBuffer(NWindow *nw, s32 slot, NvGraphicBuffer *buf)
+{
+    const void *caller = __builtin_return_address(0);
+    Result rc = __real_nwindowConfigureBuffer(nw, slot, buf);
+    report_window("configure", rc, slot, nw, caller);
+    if (buf) {
+        fprintf(stderr, "[EU-P2-D1][graphics] buffer=%p planes=%u size=%ux%u"
+                " stride=%u format=0x%X usage=0x%X total_size=%u"
+                " nvmap_id=%d\n", (void *)buf, buf->num_planes,
+                buf->planes[0].width, buf->planes[0].height, buf->stride,
+                buf->format, buf->usage, buf->total_size, buf->nvmap_id);
+    }
+    if (R_FAILED(rc))
+        nfsu2_nx_graphics_flush();
+    return rc;
+}
+
+Result __real_nwindowDequeueBuffer(NWindow *, s32 *, NvMultiFence *);
+__attribute__((noinline))
+Result __wrap_nwindowDequeueBuffer(NWindow *nw, s32 *out_slot, NvMultiFence *fence)
+{
+    const void *caller = __builtin_return_address(0);
+    Result rc = __real_nwindowDequeueBuffer(nw, out_slot, fence);
+    /* Failed output arguments are unspecified: never read them. */
+    if (R_FAILED(rc) || !s_dequeue_seen++)
+        report_window("dequeue", rc, R_SUCCEEDED(rc) && out_slot ? *out_slot : -1,
+                      nw, caller);
+    if (R_FAILED(rc))
+        nfsu2_nx_graphics_flush();
+    return rc;
+}
+
+Result __real_nwindowQueueBuffer(NWindow *, s32, const NvMultiFence *);
+__attribute__((noinline))
+Result __wrap_nwindowQueueBuffer(NWindow *nw, s32 slot, const NvMultiFence *fence)
+{
+    const void *caller = __builtin_return_address(0);
+    Result rc = __real_nwindowQueueBuffer(nw, slot, fence);
+    if (R_FAILED(rc) || !s_queue_seen++)
+        report_window("queue", rc, slot, nw, caller);
+    if (R_FAILED(rc))
+        nfsu2_nx_graphics_flush();
+    return rc;
+}
+
+__attribute__((noreturn)) void __real_fatalThrow(Result rc);
+__attribute__((noreturn, noinline)) void __wrap_fatalThrow(Result rc)
+{
+    const void *caller = __builtin_return_address(0);
+    fprintf(stderr, "[EU-P2-D1][FATAL] rc=0x%X module=%u description=%u"
+            " stage=%s caller=%p ELF_CALLER=0x%08X\n",
+            rc, R_MODULE(rc), R_DESCRIPTION(rc),
+            s_stage ? s_stage : "before-graphics-stage", caller,
+            nfsu2_nx_graphics_offset(caller));
+    nfsu2_nx_graphics_flush();
+    __real_fatalThrow(rc);
+}
+#endif
