+/* libnx abort() can go straight through _exit(1), without an error applet
+ * or CPU exception. Capture that path before services and the log close. */
+#ifdef __SWITCH__
+#include <stdio.h>
+#include <stdatomic.h>
+#include "switch_graphics_debug.h"
+#include "eu_debug.h"
+
+static atomic_flag s_terminating = ATOMIC_FLAG_INIT;
+
+static void termination_report(const char *kind, int rc, const void *caller)
+{
+    /* exit -> _exit -> libnx exit is one termination. Avoid repeating the
+     * dump during teardown, and let recursive/concurrent exits pass through. */
+    if (atomic_flag_test_and_set(&s_terminating))
+        return;
+    fprintf(stderr, "[EU-P2-D2][TERMINATE] path=%s code=%d caller=%p"
+            " ELF_CALLER=0x%08X\n", kind, rc, caller,
+            nfsu2_nx_graphics_offset(caller));
+    /* Commit the native caller first, even if obtaining thread-local
+     * history itself fails or requests another termination. */
+    nfsu2_nx_graphics_flush();
+    /* Function history only: do not dereference potentially corrupt guest
+     * stack/memory while handling an abort. */
+    nfsu2_eu_debug_dump();
+    nfsu2_nx_graphics_flush();
+}
+
+__attribute__((noreturn)) void __real_abort(void);
+__attribute__((noreturn, noinline)) void __wrap_abort(void)
+{
+    termination_report("abort", 1, __builtin_return_address(0));
+    __real_abort();
+}
+
+__attribute__((noreturn)) void __real_exit(int);
+__attribute__((noreturn, noinline)) void __wrap_exit(int rc)
+{
+    termination_report("exit", rc, __builtin_return_address(0));
+    __real_exit(rc);
+}
+
+__attribute__((noreturn)) void __real__exit(int);
+__attribute__((noreturn, noinline)) void __wrap__exit(int rc)
+{
+    termination_report("_exit", rc, __builtin_return_address(0));
+    __real__exit(rc);
+}
+
+__attribute__((noreturn)) void __real___libnx_exit(int);
+__attribute__((noreturn, noinline)) void __wrap___libnx_exit(int rc)
+{
+    termination_report("libnx exit", rc, __builtin_return_address(0));
+    __real___libnx_exit(rc);
+}
