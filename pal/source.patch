+/* CRC is an accidental-mismatch guard; SHA256 above identifies the build input. */
+static inline uint32_t nfsu2_eu_crc32(const void *data, size_t size)
+{
+    const uint8_t *p = (const uint8_t *)data;
+    uint32_t crc = ~0u;
+    while (size--) {
+        crc ^= *p++;
+        for (unsigned k = 0; k < 8; k++)
+            crc = (crc >> 1) ^ (0xEDB88320u & (0u - (crc & 1u)));
+    }
+    return ~crc;
+}
+static inline int nfsu2_eu_xbe_matches(const void *data, size_t size)
+{
+    return size == NFSU2_EU_XBE_SIZE && nfsu2_eu_crc32(data, size) == NFSU2_EU_XBE_CRC32;
+}
