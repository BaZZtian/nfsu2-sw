+/* Sampled, optional timestamps. Results are read only after the frame fence;
+ * never add QUERY_RESULT_WAIT or a GPU idle to obtain profiling data. */
+#define GPU_PAIRS 48u
+#define GPU_QUERIES (2u + 2u * GPU_PAIRS)
+typedef struct {
+    uint32_t va, width, height, output;
+} GpuPair;
+typedef struct {
+    VkQueryPool pool;
+    uint32_t count;
+    int active, armed, open;
+    GpuPair pair[GPU_PAIRS];
+} GpuTiming;
+static double s_gpu_period;
+static uint32_t s_gpu_bits, s_gpu_every, s_gpu_serial;
+static PFN_vkCreateQueryPool p_gpu_create;
+static PFN_vkDestroyQueryPool p_gpu_destroy;
+static PFN_vkGetQueryPoolResults p_gpu_results;
+static PFN_vkCmdResetQueryPool p_gpu_reset;
+static PFN_vkCmdWriteTimestamp p_gpu_stamp;
+
+static int gpu_init(GpuTiming *a, GpuTiming *b)
+{
+    const char *e = getenv("RECOMP_VK_GPU_TIMING");
+    unsigned long every = e ? strtoul(e, NULL, 10) : 0;
+    if (!every) return 0;
+    if (!s_gpu_bits || s_gpu_bits > 64 || !(s_gpu_period > 0)) {
+        LOGE("GPU timing unavailable: timestamp bits %u period %g\n", s_gpu_bits, s_gpu_period);
+        return 0;
+    }
+#define GPU_PROC(member, name) member = (PFN_##name)vkGetDeviceProcAddr(s_dev, #name)
+    GPU_PROC(p_gpu_create, vkCreateQueryPool);
+    GPU_PROC(p_gpu_destroy, vkDestroyQueryPool);
+    GPU_PROC(p_gpu_results, vkGetQueryPoolResults);
+    GPU_PROC(p_gpu_reset, vkCmdResetQueryPool);
+    GPU_PROC(p_gpu_stamp, vkCmdWriteTimestamp);
+#undef GPU_PROC
+    if (!p_gpu_create || !p_gpu_destroy || !p_gpu_results || !p_gpu_reset || !p_gpu_stamp) {
+        LOGE("GPU timing unavailable: optional query entry points missing\n");
+        return 0;
+    }
+    GpuTiming *frames[] = { a, b };
+    VkQueryPoolCreateInfo ci = { VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO };
+    ci.queryType = VK_QUERY_TYPE_TIMESTAMP;
+    ci.queryCount = GPU_QUERIES;
+    for (unsigned i = 0; i < 2; ++i) {
+        VkResult result = p_gpu_create(s_dev, &ci, NULL, &frames[i]->pool);
+        if (result != VK_SUCCESS) {
+            for (unsigned j = 0; j < i; ++j) {
+                p_gpu_destroy(s_dev, frames[j]->pool, NULL);
+                frames[j]->pool = VK_NULL_HANDLE;
+            }
+            frames[i]->pool = VK_NULL_HANDLE;
+            LOGE("GPU timing unavailable: query allocation VkResult %d\n", (int)result);
+            return 0;
+        }
+    }
+    s_gpu_every = every > 1000000 ? 1000000 : (uint32_t)every;
+    LOGE("GPU timing on: every %u frames, %u valid bits, %g ns/tick; nonblocking results\n",
+         s_gpu_every, s_gpu_bits, s_gpu_period);
+    return 1;
+}
+
+static double gpu_ms(uint64_t start, uint64_t end)
+{
+    uint64_t mask = s_gpu_bits == 64 ? UINT64_MAX : (UINT64_C(1) << s_gpu_bits) - 1;
+    return ((end - start) & mask) * s_gpu_period / 1e6;
+}
+
+static void gpu_collect(GpuTiming *g)
+{
+    static struct { GpuPair key; double ms, max; unsigned count; } targets[64];
+    static unsigned samples, ntargets;
+    static double total, maximum;
+    static uint64_t since;
+    if (!g->armed) return;
+    g->armed = 0;
+    if (!s_gpu_every) return;
+    uint64_t values[GPU_QUERIES][2];
+    unsigned n = 2 + 2 * g->count;
+    VkResult result = p_gpu_results(s_dev, g->pool, 0, n, sizeof values, values,
+        sizeof values[0], VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT);
+    if (result == VK_NOT_READY) return;
+    if (result != VK_SUCCESS) {
+        LOGE("GPU timing disabled: result VkResult %d (rendering continues)\n", (int)result);
+        s_gpu_every = 0;
+        return;
+    }
+    for (unsigned i = 0; i < n; ++i) if (!values[i][1]) return;
+    double ms = gpu_ms(values[0][0], values[1][0]);
+    total += ms; if (ms > maximum) maximum = ms; ++samples;
+    for (unsigned i = 0; i < g->count; ++i) {
+        unsigned t;
+        for (t = 0; t < ntargets; ++t)
+            if (!memcmp(&targets[t].key, &g->pair[i], sizeof(GpuPair))) break;
+        if (t == ntargets) {
+            if (ntargets == 64) continue;
+            targets[t].key = g->pair[i]; ++ntargets;
+        }
+        ms = gpu_ms(values[2 + 2*i][0], values[3 + 2*i][0]);
+        targets[t].ms += ms; ++targets[t].count;
+        if (ms > targets[t].max) targets[t].max = ms;
+    }
+    uint64_t now = hz_now();
+    if (!since) since = now;
+    if (now - since < UINT64_C(10000000000)) return;
+    LOGE("GPU samples %u: frame mean/max %.2f/%.2f ms (ranges may overlap)\n",
+         samples, total/samples, maximum);
+    /* Bounded output: six largest accumulated target ranges. */
+    for (unsigned rank = 0; rank < 6 && rank < ntargets; ++rank) {
+        unsigned best = 0;
+        for (unsigned t = 1; t < ntargets; ++t) if (targets[t].ms > targets[best].ms) best = t;
+        if (!targets[best].count) break;
+        LOGE("GPU target %08X %ux%u%s: range mean/max %.2f/%.2f ms, %u passes\n",
+             targets[best].key.va, targets[best].key.width, targets[best].key.height,
+             targets[best].key.output ? " output" : "",
+             targets[best].ms/targets[best].count, targets[best].max, targets[best].count);
+        targets[best].ms = 0; targets[best].count = 0;
+    }
+    memset(targets, 0, sizeof targets); ntargets = samples = 0;
+    total = maximum = 0; since = now;
+}
+
+static void gpu_frame_begin(GpuTiming *g, VkCommandBuffer cb)
+{
+    g->count = 0; g->open = -1; g->active = 0;
+    if (!s_gpu_every || !g->pool || (s_gpu_serial++ % s_gpu_every)) return;
+    g->active = 1;
+    p_gpu_reset(cb, g->pool, 0, GPU_QUERIES);
+    p_gpu_stamp(cb, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, g->pool, 0);
+}
+
+static void gpu_pass_begin(GpuTiming *g, VkCommandBuffer cb,
+                           uint32_t va, uint32_t width, uint32_t height, uint32_t output)
+{
+    if (!g->active || g->count == GPU_PAIRS) return;
+    unsigned i = g->count++;
+    g->pair[i] = (GpuPair){ va, width, height, output };
+    g->open = (int)i;
+    p_gpu_stamp(cb, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, g->pool, 2 + 2*i);
+}
+
+static void gpu_pass_end(GpuTiming *g, VkCommandBuffer cb)
+{
+    if (!g->active || g->open < 0) return;
+    p_gpu_stamp(cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, g->pool, 3 + 2*(unsigned)g->open);
+    g->open = -1;
+}
+
+static void gpu_frame_end(GpuTiming *g, VkCommandBuffer cb)
+{
+    if (!g->active) return;
+    gpu_pass_end(g, cb);
+    p_gpu_stamp(cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, g->pool, 1);
+    g->active = 0; g->armed = 1;
+}
+
+static void gpu_discard(GpuTiming *g)
+{
+    /* Mid-frame flush invalidates this sample, without reusing its queries
+     * while submitted commands are pending. Resume sampling next frame. */
+    g->active = g->armed = 0; g->open = -1;
+}
